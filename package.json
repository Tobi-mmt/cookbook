{
	"name": "cookbook-svelte",
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "tsx scripts/buildMigrate.ts && vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check . && eslint --ignore-pattern '.gitignore' .",
		"format": "prettier --ignore-path .gitignore --write . && eslint --ignore-pattern '.gitignore' --fix .",
		"e2e": "cypress run",
		"test": "vitest",
		"prepare": "husky && svelte-kit sync",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dbMigrate.ts",
		"seed:from-prod": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seedFromProd.ts",
		"hash-password": "tsx scripts/hashPassword.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/pg": "^8.23.1",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"cypress": "16.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tslib": "2.8.1",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.1",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,svelte,json,md,html}": "yarn format"
	},
	"dependencies": {
		"@vercel/analytics": "2.0.1",
		"@vercel/blob": "^2.8.0",
		"@vercel/functions": "^3.9.9",
		"drizzle-orm": "^0.45.3",
		"fuse.js": "7.5.0",
		"node-html-parser": "^9.0.4",
		"pg": "^8.23.1",
		"sharp": "^0.35.0",
		"zod": "^4.6.5"
	},
	"resolutions": {
		"sharp": "^0.35.0"
	},
	"packageManager": "yarn@1.22.22"
}
