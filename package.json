{
	"name": "cookbook-svelte",
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "tsx scripts/buildMigrate.ts && vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check . && eslint --ignore-pattern '.gitignore' .",
		"format": "prettier --ignore-path .gitignore --write . && eslint --ignore-pattern '.gitignore' --fix .",
		"e2e": "cypress run",
		"test": "vitest",
		"prepare": "husky && svelte-kit sync",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dbMigrate.ts",
		"seed:from-prod": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seedFromProd.ts",
		"db:reapply-deletions": "tsx scripts/reapplyDeletions.ts",
		"backup:images": "tsx scripts/backupImages.ts",
		"restore:images": "tsx scripts/restoreImages.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-vercel": "7.0.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/pg": "^8.23.1",
		"@typescript-eslint/eslint-plugin": "8.71.0",
		"@typescript-eslint/parser": "8.71.0",
		"cypress": "16.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tslib": "2.8.1",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,svelte,json,md,html}": "yarn format"
	},
	"dependencies": {
		"@better-auth/core": "1.7.12",
		"@better-auth/passkey": "1.7.12",
		"@better-fetch/fetch": "1.3.3",
		"@lucide/svelte": "^1.56.0",
		"@vercel/blob": "^2.8.0",
		"@vercel/functions": "^3.9.9",
		"altcha-lib": "2.8.0",
		"better-auth": "1.7.12",
		"better-call": "1.4.4",
		"drizzle-orm": "^0.45.3",
		"fuse.js": "7.5.0",
		"isbot": "^5.2.2",
		"jose": "^6.2.12",
		"kysely": "^0.29.0",
		"nanostores": "^1",
		"node-html-parser": "^9.0.4",
		"pg": "^8.23.1",
		"sharp": "^0.35.0",
		"uqr": "0.1.3",
		"zod": "^4.6.5"
	},
	"resolutions": {
		"sharp": "^0.35.0"
	},
	"packageManager": "yarn@1.22.22",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/components/*",
		"#types": "./src/types.d.ts"
	}
}
