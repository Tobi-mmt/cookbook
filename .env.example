# Copy to .env for local development. Production and preview values are set in Vercel.

# podman compose up -d
POSTGRES_URL=postgres://cookbook:cookbook@localhost:5432/cookbook

# any long random string, e.g. openssl rand -base64 32 (optional locally)
BETTER_AUTH_SECRET=

# only needed on Vercel, at least 32 characters
ISR_BYPASS_TOKEN=

# leave empty locally: mails are written to the console instead
SCW_SECRET_KEY=
SCW_PROJECT_ID=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_WEBHOOK_SECRET=

# leave empty locally: images are stored in .data/blob instead of Vercel Blob
BLOB_READ_WRITE_TOKEN=

# any long random string, protects /api/cron/daily and /api/warm-cache
CRON_SECRET=
