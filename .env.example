# Copy to .env for local development. Production and preview values are set in Vercel.

# podman compose up -d
POSTGRES_URL=postgres://cookbook:cookbook@localhost:5432/cookbook

# yarn hash-password <password>   (the default here is "admin")
ADMIN_PASSWORD_HASH=scrypt:YiK5I/GPqKrIck3TV3w/5g==:sUJrngGm9DoQC/myFXJCSlgpWk2FUqIUrMraUSD1SJ+qSD0G/tYs1jvJPGZpWTQyr3WI+Sa9OYwHii20cuHM9Q==
# any long random string, e.g. openssl rand -base64 32
SESSION_SECRET=

# only needed on Vercel, at least 32 characters
ISR_BYPASS_TOKEN=

# leave empty locally: images are stored in .data/blob instead of Vercel Blob
BLOB_READ_WRITE_TOKEN=
